import {
  Serialize,
  Deserialize,
  rename,
  rename_all,
  skip,
  deny_unknown_fields,
} from '@alloy/std/serde'
import * as serde from '@alloy/std/serde'
import { Attributes } from '@alloy/std/roblox'
-- User-defined attributes: declared metadata with checked placement and
-- typed arguments. Nothing is transformed. Consumers read the metadata.

const DataStoreService = game:GetService('DataStoreService')

-- Declarations name the arguments and the targets. `export` makes one
-- usable from other files, both to apply and to read.
export attribute range(min: number, max: number) on field
-- Marks a function that runs on the server only.
export attribute server_only on function
attribute icon(asset: string) on struct, enum, variant
-- serde's options come from `@alloy/std/serde` with the derives that
-- read them: `@rename_all`, `@deny_unknown_fields`, `@rename`, `@skip`.
-- `@alias` is built in: it gives a field a second key.

-- Another file would write:
--   import { range, server_only } from "./21_attributes"
--   @server_only
--   local function load() end
--   local r = Attributes.field(Health, "current", range)

@icon('rbxassetid:/100')
@derive(Serialize, Deserialize)
@rename_all('camelCase')
@deny_unknown_fields
struct Health
  -- `from_table` also reads this field from the key `hp`.
  @range(0, 100)
  @alias('hp')
  current: number = 100

  -- `@rename_all` gives this field the key `maxHealth`.
  max_health: number

  -- A field's own `@rename` wins over `@rename_all`.
  @rename('regen_per_second')
  regen: number

  -- `@skip` keeps a field out of the table.
  @skip
  last_hit: number?
end

-- `@deny_unknown_fields` makes a typo in stored data fail at the load:
-- `from_table({ maxHeath = 100 })` raises "Health has no field maxHeath".
const stored = Health.from_table({ hp = 80, maxHealth = 100, regen_per_second = 2 })

-- A star import reaches the same names through the module.
@derive(serde.Deserialize)
@serde.deny_unknown_fields
struct Settings
  volume: number = 1
end

const settings = Settings.from_table({ volume = 0.5 })

@icon('rbxassetid:/200')
enum Team
  @icon('rbxassetid:/201')
  Red
  Blue
end

@server_only
local function save(player: Player, health: Health)
  DataStoreService:GetDataStore('health'):SetAsync(tostring(player.UserId), health:to_table())
end

-- Reading at runtime. Results are typed from the declaration.
const field_range = Attributes.field(Health, 'current', range) -- { min: number, max: number }?
const struct_icon = Attributes.get(Health, icon) -- string?
const red_icon = Attributes.variant(Team, 'Red', icon)
const on_save = Attributes.of(save) -- every attribute on save
const guarded = Attributes.get(save, server_only) ~= nil

-- A wrong target is a compile error:
-- @range(0, 1)
-- local function bad() end

-- A wrong argument type is a compile error:
-- @range("low", "high")
-- current: number

-- Luau's own attribute list passes through, so a Luau file stays valid
-- Alloy. `deprecated` there takes Luau's table.
@[native]
local function mix(a: number, b: number, t: number): number
  return a + (b - a) * t
end

-- `@deprecated` takes a message, or the table Luau's list takes: `use`
-- names the function to call instead, so a call to `blend` draws a lint
-- that names `mix`.
@deprecated({ use = 'mix', reason = 'renamed' })
local function blend(a: number, b: number, t: number): number
  return mix(a, b, t)
end

@deprecated('renamed to mix')
local function fade(a: number, b: number, t: number): number
  return mix(a, b, t)
end

-- `@allow(lint)` quiets one lint on the item it sits on, and moves with
-- the item. A `--@alloy-` directive covers one line, a run of lines, or
-- a file. `dead_code` is Rust's name for `unused_function`.
@allow(dead_code)
local function dump(health: Health)
  print(health:to_table())
end

-- A generic validator reads the metadata instead of hard-coding rules.
-- A lint name may carry its tool: `flux.` here, or `luau.` or `alx.`.
@allow(flux.explicit_any)
local function validate<T>(value: T, struct_type: any) -> Result<T, string>
  for name, r in Attributes.fields(struct_type, range) do
    const v = (value :: any)[name]
    if v < r.min or v > r.max then
      return Err(`{name} must be in [{r.min}, {r.max}]`)
    end
  end
  return Ok(value)
end

print(field_range, struct_icon, red_icon, on_save, guarded, validate)
print(stored, settings, mix(0, 10, 0.5))
