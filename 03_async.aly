-- Async functions return a Future. `await` yields until it settles.

const HttpService = game:GetService('HttpService')
const DataStoreService = game:GetService('DataStoreService')

type Profile = { name: string, level: number }

-- `async` means one thing: the function returns Future<Profile>.
-- The body runs on task.spawn under xpcall. The Future stores the result.
-- `async` sits where `function` sits, after `local`, `const`, or `export`.
local async function load_profile(user_id: number) -> Profile
  const store = DataStoreService:GetDataStore('profiles')
  const raw = store:GetAsync(`profile/{user_id}`)
  return HttpService:JSONDecode(raw)
end

const async function load_many(ids: { number }): { Profile }
  local futures = {}
  for i, id in ids do
    futures[i] = load_profile(id)
  end
  -- Future.all settles when every Future settles.
  return await Future.all(futures)
end

-- `await` needs an async context. A plain function is not one, so this
-- one is marked `async`; the other fix is `async do ... end` around the
-- body. The context is per function: a `function` inside an `async
-- function` is plain again.
local async function greet(user_id: number)
  const profile = await load_profile(user_id)
  print(`Welcome back, {profile.name} (level {profile.level})`)
end

-- The rule is not style. `await` yields, and Luau cannot yield out of a
-- callback it runs from C: on Roblox a `table.sort` comparator that
-- awaits dies with "attempt to yield across metamethod/C-call
-- boundary". Read what you need before the sort, where the yield is
-- safe, and the comparator stays plain.
local async function ranked(ids: { number }): { number }
  local levels = {}
  for _, id in ids do
    levels[id] = (await load_profile(id)).level
  end

  const order = table.clone(ids)
  table.sort(order, function(a, b)
    -- `await load_profile(a)` here is the error the rule catches.
    return levels[a] < levels[b]
  end)
  return order
end

-- Awaitable protocol: anything with the awaitable shape works, including
-- an evaera Promise, with no wrapper.
local async function wait_for_promise(promise: any) --@alloy-ignore a Promise has no type here
  return await promise
end

-- A settled Future resolves at once. A failed Future rethrows the stored
-- error with the traceback captured at the failure site. This file is a
-- module, so its top level runs inside `require`: the reads go in an
-- `async do` block, which starts a thread of its own.
const first = load_profile(1)
const twice = async do
  const again = await first
  const same = await first
  print(again.name == same.name)
end

-- Cancellation stops work that has not started and rejects waiters.
const slow = load_many({ 1, 2, 3 })
slow:cancel()

-- An async function expression.
const ping = async function(): number
  return os.clock()
end

-- `async do` stands alone as a statement too, and drops the Future.
async do
  print(await ping())
end

print(twice, greet, ranked, wait_for_promise)
