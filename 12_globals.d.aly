-- A declaration file: globals that every file sees with no import. It
-- holds no runtime, and `alloy build` writes nothing for it. The editor
-- and `alloy flux` load it as definitions.

-- Luau's definition syntax works as is.
declare function warn_once(message: string): ()

declare extern type PluginToolbar with
  function CreateButton(self, id: string, tooltip: string, icon: string): PluginToolbarButton
end

declare plugin: Plugin

-- Alloy type sugar works here too. Every type is global, with or
-- without `export`.
interface Serializable
  read version: number
  write debug_sink: (string) -> ()
end

interface SaveData extends Serializable
  coins: number
  items: { string }
end

trait Codec
  function encode(self): string
  function decode(self, raw: string): SaveData
end

-- An enum is a type alone here. The host gives the values, and a
-- file writes one as its string: `local q: Quality = "High"`.
enum Quality
  Low,
  High,
end

-- Type functions are allowed here, written by hand or generated.
type function Keys(t)
  const out: { type } = {}
  for k in t:properties() do
    table.insert(out, k)
  end
  return types.unionof(table.unpack(out))
end

export type Patch<T> = { [K in keyof T]: T[K]? }
